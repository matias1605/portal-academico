@model Curso
@{
    ViewData["Title"] = "Editar Curso";
}

<h2 class="mb-4">Editar Curso</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p class="mb-0">@error.ErrorMessage</p>
        }
    </div>
}

<form method="post" asp-action="Editar" style="max-width: 500px;">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label class="form-label">Código</label>
        <input asp-for="Codigo" class="form-control" />
        <span asp-validation-for="Codigo" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Créditos</label>
        <input asp-for="Creditos" type="number" min="1" class="form-control" />
        <span asp-validation-for="Creditos" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Cupo máximo</label>
        <input asp-for="CupoMaximo" type="number" min="1" class="form-control" />
        <span asp-validation-for="CupoMaximo" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Horario inicio</label>
        <input asp-for="HorarioInicio" type="time" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Horario fin</label>
        <input asp-for="HorarioFin" type="time" class="form-control" />
    </div>

    <div class="mb-3 form-check">
        <input asp-for="Activo" type="checkbox" class="form-check-input" />
        <label class="form-check-label">Activo</label>
    </div>

    <button type="submit" class="btn btn-success">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
</form>