@model IEnumerable<Matricula>
@{
    ViewData["Title"] = "Matrículas del curso";
}

<h2 class="mb-2">Matrículas — @ViewBag.CursoNombre</h2>
<a asp-action="Index" class="btn btn-secondary btn-sm mb-4">Volver al panel</a>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay matrículas registradas para este curso.</div>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Usuario</th>
                <th>Fecha de registro</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.UsuarioId</td>
                    <td>@m.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <span class="badge bg-@(m.Estado == EstadoMatricula.Confirmada ? "success" :
                                                m.Estado == EstadoMatricula.Cancelada  ? "danger"  : "warning")">
                            @m.Estado
                        </span>
                    </td>
                    <td>
                        @if (m.Estado == EstadoMatricula.Pendiente)
                        {
                            <form asp-action="Confirmar" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@m.Id" />
                                <input type="hidden" name="cursoId" value="@ViewBag.CursoId" />
                                <button type="submit" class="btn btn-sm btn-success">Confirmar</button>
                            </form>

                            <form asp-action="Cancelar" method="post" class="d-inline ms-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@m.Id" />
                                <input type="hidden" name="cursoId" value="@ViewBag.CursoId" />
                                <button type="submit" class="btn btn-sm btn-danger">Cancelar</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">Sin acciones</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}